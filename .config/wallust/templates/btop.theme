# Wallust generated btop theme
theme[main_bg]="#{background.strip}"
theme[main_fg]="#{foreground.strip}"
theme[title]="#{color4.strip}"
theme[hi_fg]="#{color2.strip}"
theme[selected_bg]="#{color1.strip}"
theme[selected_fg]="#{foreground.strip}"
theme[inactive_fg]="#{color8.strip}"
theme[proc_misc]="#{color3.strip}"
theme[cpu_box]="#{color4.strip}"
theme[mem_box]="#{color2.strip}"
theme[net_box]="#{color6.strip}"
theme[proc_box]="#{color5.strip}"
theme[div_line]="#{color8.strip}"
theme[temp_start]="#{color2.strip}"
theme[temp_mid]="#{color3.strip}"
theme[temp_end]="#{color1.strip}"
theme[cpu_start]="#{color2.strip}"
theme[cpu_mid]="#{color4.strip}"
theme[cpu_end]="#{color1.strip}"
theme[free_start]="#{color4.strip}"
theme[free_mid]="#{color6.strip}"
theme[free_end]="#{color2.strip}"
theme[cached_start]="#{color2.strip}"
theme[cached_mid]="#{color3.strip}"
theme[cached_end]="#{color6.strip}"
theme[available_start]="#{color6.strip}"
theme[available_mid]="#{color4.strip}"
theme[available_end]="#{color2.strip}"
theme[used_start]="#{color1.strip}"
theme[used_mid]="#{color3.strip}"
theme[used_end]="#{color4.strip}"
theme[download_start]="#{color4.strip}"
theme[download_mid]="#{color6.strip}"
theme[download_end]="#{color2.strip}"
theme[upload_start]="#{color1.strip}"
theme[upload_mid]="#{color3.strip}"
theme[upload_end]="#{color5.strip}"
theme[process_start]="#{color2.strip}"
theme[process_mid]="#{color4.strip}"
theme[process_end]="#{color1.strip}"
